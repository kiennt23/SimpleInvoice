# Copy this file to .env for local development. Never commit real secrets.

# Backend persistence (required)
DATABASE_URL=postgresql://simpleinvoice:simpleinvoice-local-password@localhost:5432/simpleinvoice

# Backend authentication (JWT_SECRET is required; replace this placeholder locally)
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN_SECONDS=3600

# Backend business/API settings
BUSINESS_TIME_ZONE=UTC
APP_ORIGIN=http://localhost:5173
PORT=3000

# Seed reviewer (optional; these are safe local review defaults)
SEED_REVIEWER_EMAIL=reviewer@simpleinvoice.local
SEED_REVIEWER_PASSWORD=reviewer-local-password

# Compose PostgreSQL initialization
POSTGRES_USER=simpleinvoice
POSTGRES_PASSWORD=simpleinvoice-local-password
POSTGRES_DB=simpleinvoice
